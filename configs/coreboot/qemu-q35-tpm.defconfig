# Valid Coreboot defconfig for QEMU Q35 (x86_64) with TPM 2.0 Measured Boot
CONFIG_VENDOR_EMULATION=y
CONFIG_BOARD_EMULATION_QEMU_X86_Q35=y

# 4MB ROM
CONFIG_BOARD_ROMSIZE_KB_4096=y

# Serial console
CONFIG_CONSOLE_SERIAL=y
CONFIG_CONSOLE_CBMEM=y

# TPM 2.0 Measured Boot
CONFIG_TPM2=y
CONFIG_TPM_MEASURED_BOOT=y
CONFIG_VBOOT_MEASURED_BOOT=y
CONFIG_DEBUG_TPM=y

# SeaBIOS payload (boots standard Linux/GRUB disk images)
CONFIG_PAYLOAD_SEABIOS=y
